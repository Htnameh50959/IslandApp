<?xml version="1.0" encoding="utf-8"?>
<!-- Window and click/selection events let Island notice copied text (Copy suggestions);
     key events let the volume pill follow the volume keys. -->
<accessibility-service xmlns:android="http://schemas.android.com/apk/res/android"
    android:accessibilityEventTypes="typeWindowStateChanged|typeWindowContentChanged|typeViewClicked|typeViewTextSelectionChanged|typeNotificationStateChanged"
    android:accessibilityFeedbackType="feedbackGeneric"
    android:accessibilityFlags="flagDefault|flagRetrieveInteractiveWindows|flagReportViewIds"
    android:canRetrieveWindowContent="true"
    android:canRequestFilterKeyEvents="true"
    android:description="@string/a11y_description"
    android:notificationTimeout="100" />

<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Base -->
    <item>
        <shape>
            <solid android:color="@color/bg" />
        </shape>
    </item>
    <!-- Soft vertical wash -->
    <item>
        <shape>
            <gradient
                android:angle="270"
                android:startColor="@color/bg_wash_top"
                android:endColor="@color/bg_wash_bottom" />
        </shape>
    </item>
    <!-- Island glow — top centre, like the pill -->
    <item>
        <shape>
            <gradient
                android:type="radial"
                android:gradientRadius="320dp"
                android:centerX="0.5"
                android:centerY="0.02"
                android:startColor="@color/bg_glow_island"
                android:endColor="#00000000" />
        </shape>
    </item>
    <!-- Cool accent, upper left -->
    <item>
        <shape>
            <gradient
                android:type="radial"
                android:gradientRadius="420dp"
                android:centerX="0.05"
                android:centerY="0.18"
                android:startColor="@color/bg_glow_cool"
                android:endColor="#00000000" />
        </shape>
    </item>
    <!-- Warm accent, lower right -->
    <item>
        <shape>
            <gradient
                android:type="radial"
                android:gradientRadius="460dp"
                android:centerX="0.92"
                android:centerY="0.88"
                android:startColor="@color/bg_glow_warm"
                android:endColor="#00000000" />
        </shape>
    </item>
</layer-list>

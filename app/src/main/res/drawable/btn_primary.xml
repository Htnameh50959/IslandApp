<ripple xmlns:android="http://schemas.android.com/apk/res/android" android:color="#44FFFFFF">
    <item>
        <layer-list>
            <item>
                <shape android:shape="rectangle">
                    <gradient android:angle="270" android:startColor="#E65AB0FF" android:endColor="#CC0A84FF" />
                    <corners android:radius="100dp" />
                    <stroke android:width="0.8dp" android:color="#80FFFFFF" />
                </shape>
            </item>
            <item android:bottom="14dp">
                <shape android:shape="rectangle">
                    <gradient android:angle="270" android:startColor="#40FFFFFF" android:endColor="#00FFFFFF" />
                    <corners android:topLeftRadius="100dp" android:topRightRadius="100dp" />
                </shape>
            </item>
        </layer-list>
    </item>
</ripple>
